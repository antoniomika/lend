{{template "base" .}}

{{define "title"}}{{.Data.Title}}{{end}}

{{define "attrs"}}class="container"{{end}}

{{define "body"}}
{{template "nav" .}}

<main id="main">
  <div class="flex flex-col gap-2">
    <div class="hero">
      <div class="box">
        <div class="text-sm mono text-grey mb">lend: ~</div>
        <h1 class="m-0"><span class="text-green">$</span> lend ssh</h1>
        <p class="mono mt">Remote commands, approved on your laptop</p>
        <div class="flex items-center gap my mono">
          <a href="/getting-started.html">[get started]</a>
          <a href="/sitemap.html">[docs]</a>
        </div>
      </div>
    </div>

    <article class="features">
      <div class="box">
        <h3 class="m-0">
          Commands on your laptop
        </h3>
        <p class="my">Keep tools such as <code>gh</code> and <code>op</code> local. Remote requests get the output and exit code back, under your <a href="/command-policy.html">command policy</a>.</p>
      </div>

      <div class="box">
        <h3 class="m-0">
          Your SSH agent, with approval
        </h3>
        <p class="my">Choose which <a href="/ssh-keys.html">SSH keys</a> are visible and how they can sign. Each request is checked before it reaches your existing agent.</p>
      </div>

      <div class="box">
        <h3 class="m-0">
          Review access locally
        </h3>
        <p class="my">Use Touch ID on macOS or a local prompt on Linux. See the request, its reason, and its <a href="/approval.html">caller context</a> before you allow it.</p>
      </div>
    </article>

    <div>
      <hr />
    </div>

    <div class="group-2 home-features">
      <div class="box">
        <pre><code># On your laptop
lend ssh --config ./policy.json -- agent-vm

# On the remote host
lend exec --reason "Inspect the pull request" -- \
  gh pr view 123 --repo example/project</code></pre>
      </div>

      <div class="text-center mono my">
        <a href="/how-it-works.html">[learn more]</a>
      </div>
    </div>

    <hr class="my-4" />

    {{template "footer" .}}
  </div>
</main>
{{end}}
